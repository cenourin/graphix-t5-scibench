# MODERN_A top-level requirements, image a5 (PORTABILIDADE.md §3.1, step A6). Resolved into
# requirements-a5.lock by docker/modern/lock.sh; the image installs only the lock.
#
# Base image (pinned by digest in the Dockerfile) already provides:
#   Python 3.11.9, torch 2.4.0 (CUDA 12.1, cuDNN 9.1.0), numpy 1.26.4.
# torch is 2.4.0, not 2.4.1: the dgl 2.4.0+cu121 wheel declares Requires-Dist torch<=2.4.0.

# core
dgl==2.4.0+cu121
transformers==4.57.6
datasets==2.21.0
numpy==1.26.4

# tokenizer: the T5 fast tokenizer is converted from spiece.model when tokenizer.json is absent
sentencepiece==0.2.0
protobuf==5.28.2

# Transitive dependencies that the resolver would otherwise take at their newest release
# (pandas 3.x, pyarrow 25.x, scipy 1.17.x, protobuf 7.x), all far newer than datasets
# 2.21.0 (2024-08) and dgl 2.4.0 (2024-09). Pinned to releases of the same period.
pandas==2.2.3
pyarrow==17.0.0
scipy==1.14.1
fsspec==2024.6.1

# A6: evaluators (third_party/, the ElementAI forks the legacy image uses) at the legacy
# image's versions: exact match goes through nltk's word_tokenize, so nltk and its punkt
# data (docker/modern/nltk_data, copied from the legacy image) must be the same.
nltk==3.7
sqlparse==0.4.2
# tqdm: the legacy 4.63.0 is impossible (datasets 2.21 needs tqdm>=4.66.3); it only draws
# progress bars and takes no part in any computation, so it is left to the resolver.

# A6: Optuna search, at the versions the legacy runs installed at runtime (optuna<4)
optuna==3.6.2
sqlalchemy==1.4.54
alembic==1.12.1

# A6.2a: rapidfuzz is pinned to the legacy 2.0.5, which has no Python 3.11 wheel and whose
# sdist ships Cython output that does not compile for 3.11: the Dockerfile's build stage
# regenerates it from the original .pyx and builds the wheel (not resolved through this
# file). rapidfuzz 2.0.5 has no runtime dependencies.

# A6.2: transformers' Trainer needs accelerate. The metadata says >=0.26.0, but 4.57.6 calls
# Accelerator.unwrap_model(keep_torch_compile=...), first available in 1.3.0 (1.1.1 and
# 1.2.1 fail); 1.3.0 is the lowest release that works and supports torch>=2.0.
accelerate==1.3.0
